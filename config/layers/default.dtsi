default_layer {
  display-name = "default";
  bindings = <
    &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 2                                                           &mo 4 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
    &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &kp C_VOL_UP                                                     &kp C_MUTE &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
    &none     &kp A     &hm_l LALT S  &hm_l LCTRL D  &hm_l LGUI F  &kp G  &kp C_VOL_DN        &none     &none    &none     &none             &kp C_PP &kp H  &hm_r RGUI J  &hm_r RCTRL K  &hm_r RALT L  &kp SEMI &kp SQT
    &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
    &mo 3     &kp GRAVE &none    &none    &none                   &kp BSPC &lt 1 ESC &kp END  &kp PG_DN &kp ENTER &kp SPACE              &none  &none     &kp LBKT &kp RBKT &mo 3
  >;
};
