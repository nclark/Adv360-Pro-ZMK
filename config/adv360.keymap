#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

// Key position definitions for homerow mods
#define KEYS_L 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64   // Left side keys  
#define KEYS_R 7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 // Right side keys

#define THUMBS_LEFT  35 36 52 65 66 67   // Left thumb cluster
#define THUMBS_RIGHT 37 38 53 68 69 70   // Right thumb cluster

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      // Left-hand homerow mods (only activate with right-hand keys)
      hm_l: homerow_mods_left {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS_LEFT";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "tap-preferred";
          hold-trigger-key-positions = <KEYS_R THUMBS_RIGHT>; // Doesn't do anything
          hold-trigger-on-release;
          bindings = <&kp>, <&kp>;
      };

      // Right-hand homerow mods (only activate with left-hand keys)  
      hm_r: homerow_mods_right {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS_RIGHT";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "tap-preferred";
          hold-trigger-key-positions = <KEYS_L THUMBS_LEFT>; // Doesn't do anything
          hold-trigger-on-release;
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    #include "layers/default.dtsi"
    #include "layers/navigation.dtsi"
    #include "layers/keypad.dtsi"
    #include "layers/function.dtsi"
    #include "layers/mod.dtsi"
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
