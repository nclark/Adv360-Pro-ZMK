 }
 
+static int zmk_rgb_underglow_battery_level();
+
+// Low-battery warning: while this half's own charge is at or below the threshold,
+// its leftmost indicator LED shows the battery band (as Mod+Hotkey 4, except the
+// 20-49% band is yellow rather than orange, which reads as red on these LEDs)
+// instead of its usual meaning, and blinks (1 Hz) at or below the blink level.
+// Each half reads its own fuel gauge. A reading of 0 means "no reading yet".
+static const struct led_rgb LOW_BATTERY_COLORS[] = {LED_RGB(0x00FF00), LED_RGB(0xFFFF00),
+                                                    LED_RGB(0xFFFF00), LED_RGB(0xFF0000)};
+static void zmk_rgb_underglow_low_battery_override(int pixel) {
+#if CONFIG_ZMK_RGB_UNDERGLOW_LOW_BATTERY_THRESHOLD > 0
+    uint8_t soc = zmk_battery_state_of_charge();
+    if (soc > 0 && soc <= CONFIG_ZMK_RGB_UNDERGLOW_LOW_BATTERY_THRESHOLD) {
+#if CONFIG_ZMK_RGB_UNDERGLOW_LOW_BATTERY_BLINK > 0
+        if (soc <= CONFIG_ZMK_RGB_UNDERGLOW_LOW_BATTERY_BLINK && (k_uptime_get() / 500) % 2) {
+            pixels[pixel] = LED_RGB(0x000000);
+            return;
+        }
+#endif
+        pixels[pixel] = LOW_BATTERY_COLORS[zmk_rgb_underglow_battery_level()];
+    }
+#endif
+}
+
